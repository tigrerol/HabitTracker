<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst entitlements for the widget extension, the counterpart to
	     Config/HabitTracker-Catalyst.entitlements. Wired per-target in the
	     pbxproj because the widget sets CODE_SIGN_ENTITLEMENTS there, which
	     shadows the sdk-conditional in Config/Shared.xcconfig. -->

	<!-- Required: macOS app extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Team-prefixed on macOS, unlike iOS. Must match the app's group so both
	     land in the same container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.tigrerol.habittracker</string>
	</array>
</dict>
</plist>
