<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tigrerol.habittracker</string>
	</array>

	<!-- iCloud sync: SwiftData's store syncs through the private CloudKit
	     database, preference data through the key-value store. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.tigrerol.habittracker</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>

	<!-- CloudKit tells the other device to sync via a silent push, which needs
	     this. development/production is picked per build configuration in
	     Debug.xcconfig and Release.xcconfig. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>

	<!-- AI agents can safely modify this file to add capabilities -->
	
	<!-- Example entitlements (commented out by default):
	
	<key>com.apple.developer.healthkit</key>
	<true/>
	
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	
	<key>com.apple.developer.contacts.notes</key>
	<true/>
	
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mycompany.HabitTracker</string>
	</array>
	
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.mycompany.HabitTracker</string>
	</array>
    
	-->
</dict>
</plist>
