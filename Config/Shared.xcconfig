// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = HabitTracker
PRODUCT_DISPLAY_NAME = HabitTracker
PRODUCT_BUNDLE_IDENTIFIER = com.pregs.habittracker
MARKETING_VERSION = 1.0
// Auto-increment build number based on git commits or timestamp
// This will be dynamically set by build scripts
CURRENT_PROJECT_VERSION = 260816.2029

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// Mac Catalyst — run the iOS app as a real Mac app (Apple Silicon).
// Mac idiom renders at 100% with AppKit-style controls rather than the
// scaled-down iPad idiom.
SUPPORTS_MACCATALYST = YES
MACCATALYST_OPTIMIZE_FOR_MAC_IDIOM = YES

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// Location permissions
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = HabitTracker uses your location to automatically select the best routine for your current context (home, office, etc.)
INFOPLIST_KEY_NSLocationAlwaysUsageDescription = HabitTracker uses your location to automatically select the best routine for your current context, even when the app is in the background
INFOPLIST_KEY_NSLocationAlwaysAndWhenInUseUsageDescription = HabitTracker uses your location to automatically select the best routine for your current context, even when the app is in the background

// Live Activities and the CloudKit background mode live in
// Config/HabitTrackerInfo.plist — Xcode's INFOPLIST_KEY_ mechanism only honours
// keys it knows, and neither of those is one of them.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/HabitTracker.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/HabitTracker.entitlements

// Mac Catalyst needs its own set: macOS requires the App Sandbox, and
// sandboxed Mac apps must declare location access explicitly.
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/HabitTracker-Catalyst.entitlements
