// Release.xcconfig
// Release configuration for iOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// Expanded into the aps-environment entitlement, which CloudKit's silent
// pushes require. Distribution builds talk to the production APNs.
APS_ENVIRONMENT = production

// Release-specific optimizations
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_TESTABILITY = NO
SWIFT_COMPILATION_MODE = wholemodule